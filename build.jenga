
expect.names :
  echo test1.out >> $out

include ~/code/jenga/rulelib/expect.jenga

empty.image: create-empty-fat.sh
  ./$in1 $out >/dev/null

# big: use for interacting with
big.image: run-script-on-image.sh empty.image script-big
  ./$in1 $in2 script-big $out /dev/null

# small: used for test1 (read-ops)
small.image: run-script-on-image.sh empty.image script-small
  ./$in1 $in2 script-small $out /dev/null

test1.out : src/fat.exe small.image
  cp $in2 $in2.writable
  chmod +w $in2.writable
  ./$in1 $in2.writable > $out

# xy: use for xy-diff test (write ops)
xy.image xy.birth: run-script-on-image.sh empty.image script-xy
  ./$in1 $in2 script-xy $out

# h-prefix: the image created by my haskell fat16 code
h-xy.image : src/fat.exe empty.image script-xy xy.birth
  cp $in2 $in2.writable
  chmod +w $in2.writable
  cat script-xy | ./$in1 $in2.writable -b $$(cat xy.birth) #>/dev/null
  cp $in2.writable $out

# Be careful to keep this hack constant big enough to detect diffs
# Currently 20k lines; reaches until offset 4e200 in the image.
# Check how big the offset must be: hd /tmp/far.image | tail -3

xy.image.hd : xy.image
  hd -v $in | head -20000 > $out

h-xy.image.hd : h-xy.image
  hd -v $in | head -20000 > $out

*test-xy.diff : xy.image.hd h-xy.image.hd
  diff $in1 $in2
  #git diff --word-diff=color $in1 $in2


# Setup a new test, called del (write ops with delete), modelled on xy...


del.image del.birth: run-script-on-image.sh empty.image script-del
  ./$in1 $in2 script-del $out

h-del.image : src/fat.exe empty.image script-del del.birth
  cp $in2 $in2.writable
  chmod +w $in2.writable
  cat script-del | ./$in1 $in2.writable -b $$(cat del.birth) #>/dev/null
  cp $in2.writable $out

del.image.hd : del.image
  hd -v $in | head -20000 > $out

h-del.image.hd : h-del.image
  hd -v $in | head -20000 > $out

*test-del.diff : del.image.hd h-del.image.hd
  diff $in1 $in2
  #git diff --word-diff=color $in1 $in2
