
small.image: make-image.sh script-small create-empty-fat.sh
  ./$in1 $in2 $out >/dev/null

big.image: make-image.sh script-big create-empty-fat.sh
  ./$in1 $in2 $out > /dev/null


test1.out : src/fat.exe small.image
  cp $in2 $in2.writable
  chmod +w $in2.writable
  ./$in1 $in2.writable > $out

expect.names :
  echo test1.out >> $out

include ~/code/jenga/rulelib/expect.jenga
