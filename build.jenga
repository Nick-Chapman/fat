
fat16.image: make-image.sh script1
  ./$in1 $in2 $out >/dev/null

interact.image: make-image.sh script-interact
  ./$in1 $in2 $out > /dev/null


*top16: src/fat.exe fat16.image
  ./$in1 -16 $in2

*interact: src/fat.exe interact.image
  ./$in -i $in2


example16.out : src/fat.exe fat16.image
  ./$in1 $in2 > $out

expect.names :
  echo example16.out >> $out

include ~/code/jenga/rulelib/expect.jenga
